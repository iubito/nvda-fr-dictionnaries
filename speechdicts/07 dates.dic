# dates ISO yyyy-MM-dd, yyyy.MM.dd, yyyy-MM: raccourcis les pauses entre les nombres
# 2026-08-28
\b([0-9]{4})[\-\.]([0-9]{2})[\-\.]([0-9]{2})\b	\1, \2, \3	1	1
\b([0-9]{4})\-([0-9]{2})\b	\1, \2	1	1

# date format français sans les zéro: 1/1/26, 2/02/26, 13/3/26, 4/4/26, 5/5/26, 6/6/26, 7/7/26, 8/08/2026, 13/8/2026, 9/9/26, 3/10/26, 4/11/26, 5/12/26
\b([1-9]|[1-2]\d|3[0-1])\/0?1\/(\d{2,4})\b	\1 janvier \2	1	1
\b([1-9]|[1-2]\d)\/0?2\/(\d{2,4})\b	\1 février \2	1	1
\b([1-9]|[1-2]\d|3[0-1])\/0?3\/(\d{2,4})\b	\1 mars \2	1	1
\b([1-9]|[1-2]\d|30)\/0?4\/(\d{2,4})\b	\1 avril \2	1	1
\b([1-9]|[1-2]\d|3[0-1])\/0?5\/(\d{2,4})\b	\1 mai \2	1	1
\b([1-9]|[1-2]\d|30)\/0?6\/(\d{2,4})\b	\1 juin \2	1	1
\b([1-9]|[1-2]\d|3[0-1])\/0?7\/(\d{2,4})\b	\1 juillet \2	1	1
\b([1-9]|[1-2]\d|3[0-1])\/0?8\/(\d{2,4})\b	\1 août \2	1	1
\b([1-9]|[1-2]\d|30)\/0?9\/(\d{2,4})\b	\1 septembre \2	1	1
\b([1-9])\/10\/(\d{2,4})\b	\1 octobre \2	1	1
\b([1-9])\/11\/(\d{2,4})\b	\1 novembre \2	1	1
\b([1-9])\/12\/(\d{2,4})\b	\1 décembre \2	1	1

# ajoute un blanc à la place des tabulations, lisibilité d'un CSV ou d'un dictionnaire NVDA ;)
[\t]	 , 	1	1

# fixe le Zero-wide Space que la rédaction dans gmail, et d'autres éditeur WYSIWYG ajoutent.
# ça casse des mots, et c'est très pénible.

