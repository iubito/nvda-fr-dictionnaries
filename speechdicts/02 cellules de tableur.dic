# cellules tableur A1 à ZZ999999999999. Les nombres supérieurs sont épelés
# cas spéciaux pour F (éviter le monétaire "franc") et Y (igrec)
# majuscule uniquement pour éviter conflit avec notes do4, fa3. (musique)
\b([A-XZ])([A-XZ])(\d{1,12})\b	\1 \2 \3	1	1
\b([A-XZ])[Yy](\d{1,12})\b	\1 igrec \2	1	1
\bF(\d{1,12})\b	 ef \1	1	1
\bY(\d{1,12})\b	 igrec \1	1	1
\bYY(\d{1,12})\b	igrec igrec \1	0	1
\b[Yy]([A-XZ])(\d{1,12})\b	igrec \1 \2	1	1

#Version semestrielle : 25H2 prononcé trompeusement 25 heure 2
\b(2\d{3})(H|h)([0-2])\b	\1 H \3	1	1

# IBAN non formatté: FR761234512345123456789AB12, DE89370400445320130005...
#https://www.cic.fr/fr/particuliers/comptes/liste-des-pays-qui-utilisent-l-iban.html
\b(FR|GF|GP|MQ|NC|PF|PM|TF|WF|YT)(\d{2})(\d{4})(\d{4})(\d{2}[0-9A-Z]{2})([0-9A-Z]{4})([0-9A-Z]{4})([0-9A-Z]\d{2})\b	\1 \2, \3, \4, \5, \6, \7, \8	1	1
\bRE(\d{2})(\d{4})(\d{4})(\d{2}[0-9A-Z]{2})([0-9A-Z]{4})([0-9A-Z]{4})([0-9A-Z]\d{2})\b	R E \1, \2, \3, \4, \5, \6, \7	1	1
\bMC(\d{2})(\d{4})(\d{4})(\d{2}[0-9A-Z]{2})([0-9A-Z]{4})([0-9A-Z]{4})([0-9A-Z]\d{2})\b	M C \1, \2, \3, \4, \5, \6, \7	1	1
