# N° SIRET : 12345678900012
\b(\d{3})(\d{3})(\d{3})(\d{5})\b	\1, \2, \3, \4	1	1

\b(?<!,)(0x)?0000(\w*)\b	\1 quadruple zéro \2	1	1
\b(?<!,)(0x)?000(\w*)\b	\1 triple zéro \2	1	1

