#Variantes de nombres + compteur et nombres dans un mot
#Chiffres romains traités plus haut
#Number variants + number as counter or in the middle of word
#Roman numbers already handled
#❶❷❸ -> 123 -> 1 2 3
#espace ajouté après la transformation pour séparer chaque chiffre
#Note the space after the definition, to separate numbers
[𜳰]	0 	1	1
[𜳱❶➀➊]	1 	1	1
[𜳲❷➁➋]	2 	1	1
[𜳳❸➂➌]	3 	1	1
[𜳴❹➃➍]	4 	1	1
[𜳵❺➄➎]	5 	1	1
[𜳶❻➅➏]	6 	1	1
[𜳷❼➆➐]	7 	1	1
[𜳸❽➇➑]	8 	1	1
[𜳹❾➈➒]	9 	1	1
[❿➉➓]	10 	1	1
# @todo https://www.fileformat.info/info/unicode/category/Nd/list.htm


# N° de téléphone français : 0601020304
\b(0[1-9])(\d\d)(\d\d)(\d\d)(\d\d)\b	\1 \2 \3 \4 \5	1	1

# N° sécurité sociale français: 182091122233344
\b(1|2)(\d{2})(0[0-9]|1[0-2])(\d{2})(\d{3})(\d{3})(\d{2})\b	\1, \2, \3, \4, \5, \6, \7	1	1


#soustraction: le tiret n'est pas toujours prononcé.,
# tentative de correction pour rendre des formules et du code plus compréhensibles.
# limite à 2 nombres  et/ou variables sans parenthèses
# 5 - 3, 5 - 3.14, 3.14 - 5, 5.67 - 3.14 - 2.01, 5 - (3.14 - 2.01)
# J-7, J - 7, x-2, x - 2, variable-0.05, variable - 0.05, var-0.123, var - 0.123, var-4,56, var - 4,56
# 1-x, 1 - x, 3.14-pi, 3.14 - pi, 0.123-variable, 0.123 - variable, 4,56-var, 4,56 - var
# 1 - x - 5, 1 - (5 - x), var2 - 3, var2 - ((5 - x) - 5)
\b(\d{1,12})\.(\d{1,12}\)*) ?\- ?(\(*\d{1,12})\.(\d{1,12})\b	\1 point \2 moins \3 point \4	1	1
\b(\d{1,12}\)*) ?\- ?(\(*\d{1,12})\.(\d{1,12})\b	\1 moins \2 point \3	1	1
\b(\d{1,12})\.(\d{1,12}\)*) ?\- ?(\(*\d{1,12})\b	\1 point \2 moins \3	1	1
\b(\d{1,12}\)*) ?\- ?(\(*\d{1,12})\b	\1 moins \2	1	1
\b([A-Za-z_][A-Za-z_0-9]*\)*) ?\- ?(\(*\d{1,12})\.(\d{1,12})\b	\1 moins \2 point \3	1	1
\b([A-Za-z_][A-Za-z_0-9]*\)*) ?\- ?(\(*\d{1,12})\b	\1 moins \2	1	1
\b(\d{1,12})\.(\d{1,12}\)*) ?\- ?(\(*[A-Za-z_][A-Za-z_0-9]*)\b	\1 point \2 moins \3	1	1
\b(\d{1,12}\)*) ?\- ?(\(*[A-Za-z_][A-Za-z_0-9]*)\b	\1 moins \2	1	1
# peut faire bugger des noms de fichier comme 01 - Titre.mp3, mais ça reste compréhensible.
#ne marche pas: uniquement des variables: pas géré car pourrait perturber du littéraire, sauf si présence de parenthèses)
#ne marche pas: x - a - b, x - (a - b), (x - a) - b
# \b([A-Za-z_][A-Za-z_0-9]*\)+) ?\-? ?([A-Za-z_][A-Za-z_0-9]*)\b	\1 moins \2	1	1
# \b([A-Za-z_][A-Za-z_0-9]*) ?\-? ?(\(+[A-Za-z_][A-Za-z_0-9]*)\b	\1 moins \2	1	1


# split word and numbers
# counter download01, download02...
\b([A-Za-z]+)(\d{1,12})\b	\1 \2	1	1
# word + number + word: input2stream
\b([A-Za-z]+)(\d{1,12})([A-Za-z]+)\b	\1 \2 \3	1	1


# 3+ zéros répétés en tête ou début décimales en programmation (point décimal), ne marche pas avec virgule décimale:
# par extension, en début de mot
# 000, 00012, 1.00012, 2,000025, .000000056, 0000M, 0x000F
\b(?<!,)(0x)?00000000000000000000000000000000(\w*)\b	\1 trentdeux zéro \2	1	1
\b(?<!,)(0x)?0000000000000000000000000000000(\w*)\b	\1 trentéun zéro \2	1	1
\b(?<!,)(0x)?000000000000000000000000000000(\w*)\b	\1 trente zéro \2	1	1
