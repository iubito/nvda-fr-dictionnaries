\b(?<!,)(0x)?000000000000000000000(\w*)\b	\1 vintéun zéro \2	1	1
\b(?<!,)(0x)?00000000000000000000(\w*)\b	\1 vingt zéro \2	1	1
\b(?<!,)(0x)?0000000000000000000(\w*)\b	\1 dizneuf zéro \2	1	1
